<robot name="Eissa">
  <!-- Shared materials (declared once, referenced by name below) -->
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <!-- Macro for wheels-->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.6"/>
      <!-- Solid-box inertia formula, computed from the same properties
             used for the visual/collision geometry above, so resizing the
             chassis automatically updates the inertia too. -->
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.0085" iyz="0" izz="0.012499999999999999"/>
    </inertial>
  </link>
  <link name="base_footprint">
</link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <origin rpy="1.570795 0 0 " xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0 " xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <!-- Solid-cylinder inertia formula for a wheel spinning about its
             own axis (rotated to match the visual/collision orientation
             above), computed from Wheel_Rad/Wheel_Length/wheel_mass so any
             change to those properties updates the inertia automatically. -->
      <inertia ixx="0.00010020833333333333" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00010020833333333333"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.1 0.165 -0.015"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <origin rpy="1.570795 0 0 " xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0 " xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <!-- Solid-cylinder inertia formula for a wheel spinning about its
             own axis (rotated to match the visual/collision orientation
             above), computed from Wheel_Rad/Wheel_Length/wheel_mass so any
             change to those properties updates the inertia automatically. -->
      <inertia ixx="0.00010020833333333333" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00010020833333333333"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.1 -0.165 -0.015"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- Lidar and Camera meshes-->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_gazebo/meshes/lidar.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <!-- Solid-cylinder inertia, unrotated (this cylinder stands upright,
         matching the collision geometry above), from lidar_radius/
         lidar_length/lidar_mass. -->
      <inertia ixx="0.00020666666666666668" ixy="0.0" ixz="0.0" iyy="0.00020666666666666668" iyz="0.0" izz="0.00036"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.15 0 0.0825"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_gazebo/meshes/zed.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <!-- Solid-box inertia from camera_x_size/camera_y_size/camera_z_size/
         camera_mass, matching the collision box above. -->
      <inertia ixx="1.4999999999999999e-05" ixy="0.0" ixz="0.0" iyy="6.083333333333333e-05" iyz="0.0" izz="6.083333333333333e-05"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.215 0 0.035"/>
  </joint>
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.570795 0 -1.570795" xyz="0 0 0"/>
  </joint>
  <!-- Caster wheel: real two-joint version.
     A caster physically needs two independent rotations to behave like a
     real free-rolling wheel: it must turn sideways to follow the robot's
     direction of travel (swivel, about the vertical Z axis) and it must
     roll forward (about its horizontal axle, the Y axis). A single joint
     cannot represent two independent rotations, so this requires an
     intermediate link between the two joints:
       base_link, swivel joint (continuous, axis z), caster_swivel_link
       caster_swivel_link, roll joint (continuous, axis y), caster_wheel (mesh)
     caster_swivel_link is intentionally a small mechanism-only frame (mass
     for numerical stability only, no visual/collision geometry): it does
     not represent a distinct physical part of the robot, only the pivot
     point between the two rotations. The actual caster wheel geometry
     lives entirely on caster_wheel below.
     The mesh-alignment rotation is kept on the wheel link's own
     visual/collision origin (not on either joint), so both joints stay
     clean and axis-aligned, exactly like the two main wheels above. -->
  <link name="caster_swivel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin rpy="0 0 0" xyz="0.15 0 -0.03"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="caster_wheel">
    <visual>
      <origin rpy="-1.570795 0 -1.570795" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_gazebo/meshes/Caster_Wheel.stl" scale="3 3 3"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.570795 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <!-- Same solid-cylinder wheel formula as the two main wheels,
             rotated the same way to match the collision geometry above. -->
      <inertia ixx="1.2916666666666668e-05" ixy="0" ixz="0" iyy="2.25e-05" iyz="0" izz="1.2916666666666668e-05"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel"/>
    <origin rpy="0 0 0" xyz="0 0 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
